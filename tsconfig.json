{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"outDir": "out",
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"declaration": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.ts", "vscode.proposed.languageModelThinkingPart.d.ts"],
	"exclude": ["src/webview/ui/**", "node_modules", "out"]
}
